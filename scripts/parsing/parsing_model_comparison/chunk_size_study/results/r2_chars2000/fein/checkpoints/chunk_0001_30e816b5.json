            348.191,
            820.9442
          ],
          "text": "10 Manfred Simon und Jürgen Böhme",
          "page": 10,
          "printed_page": null,
          "block_id": "p0010_b0005",
          "section": "10 Manfred Simon und Jürgen Böhme"
