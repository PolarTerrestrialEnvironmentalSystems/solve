BLABLADOR_API_KEY=HIER_DEINEN_API_KEY_EINTRAGEN
BLABLADOR_BASE_URL=https://api.blablador.fz-juelich.de/v1/
# Modell-ID aus dem bisherigen Lauf. Verfügbarkeit mit --list-models prüfen.
BLABLADOR_MODEL=02 - Qwen3.8-Flash-Next-NVFP4, general purpose large model
BLABLADOR_MAX_REQUESTS_PER_MINUTE=30
BLABLADOR_TIMEOUT_SECONDS=600
BLABLADOR_MAX_OUTPUT_TOKENS=16000
BLABLADOR_MAX_RETRIES=3
BLABLADOR_CONTEXT_TOKENS=65536
BLABLADOR_TEMPERATURE=0
BLABLADOR_JSON_MODE=auto
BLABLADOR_THINKING_MODE=off
